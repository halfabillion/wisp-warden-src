us": 4, "shadowColor": "0;0;0", "shadowDistance": 4, "shadowOpacity": 140, "smoothed": true, "underlined": false, "text": "TapText", "font": "Righteous-Regular.ttf", "textAlignment": "center", "verticalTextAlignment": "top", "characterSize": 34, "lineHeight": 0, "color": "255;255;255"}}, {"assetStoreId": "", "bold": false, "italic": false, "name": "ScoreText", "smoothed": true, "type": "TextObject::Text", "underlined": false, "variables": [], "effects": [], "behaviors": [], "string": "ScoreText", "font": "Righteous-Regular.ttf", "textAlignment": "center", "characterSize": 60, "color": {"b": 200, "g": 240, "r": 255}, "content": {"bold": false, "isOutlineEnabled": true, "isShadowEnabled": true, "italic": false, "outlineColor": "18;8;40", "outlineThickness": 5, "shadowAngle": 90, "shadowBlurRadius": 4, "shadowColor": "0;0;0", "shadowDistance": 4, "shadowOpacity": 140, "smoothed": true, "underlined": false, "text": "ScoreText", "font": "Righteous-Regular.ttf", "textAlignment": "center", "verticalTextAlignment": "top", "characterSize": 60, "lineHeight": 0, "color": "255;240;200"}}, {"assetStoreId": "", "bold": false, "italic": false, "name": "BestText", "smoothed": true, "type": "TextObject::Text", "underlined": false, "variables": [], "effects": [], "behaviors": [], "string": "BestText", "font": "Righteous-Regular.ttf", "textAlignment": "center", "characterSize": 28, "color": {"b": 255, "g": 200, "r": 190}, "content": {"bold": false, "isOutlineEnabled": true, "isShadowEnabled": true, "italic": false, "outlineColor": "18;8;40", "outlineThickness": 3, "shadowAngle": 90, "shadowBlurRadius": 4, "shadowColor": "0;0;0", "shadowDistance": 4, "shadowOpacity": 140, "smoothed": true, "underlined": false, "text": "BestText", "font": "Righteous-Regular.ttf", "textAlignment": "center", "verticalTextAlignment": "top", "characterSize": 28, "lineHeight": 0, "color": "190;200;255"}}, {"assetStoreId": "", "bold": false, "italic": false, "name": "ComboText", "smoothed": true, "type": "TextObject::Text", "underlined": false, "variables": [], "effects": [], "behaviors": [], "string": "ComboText", "font": "Righteous-Regular.ttf", "textAlignment": "center", "characterSize": 28, "color": {"b": 90, "g": 200, "r": 255}, "content": {"bold": false, "isOutlineEnabled": true, "isShadowEnabled": true, "italic": false, "outlineColor": "18;8;40", "outlineThickness": 3, "shadowAngle": 90, "shadowBlurRadius": 4, "shadowColor": "0;0;0", "shadowDistance": 4, "shadowOpacity": 140, "smoothed": true, "underlined": false, "text": "ComboText", "font": "Righteous-Regular.ttf", "textAlignment": "center", "verticalTextAlignment": "top", "characterSize": 28, "lineHeight": 0, "color": "255;200;90"}}, {"assetStoreId": "", "bold": false, "italic": false, "name": "BannerText", "smoothed": true, "type": "TextObject::Text", "underlined": false, "variables": [], "effects": [], "behaviors": [], "string": "BannerText", "font": "Righteous-Regular.ttf", "textAlignment": "center", "characterSize": 34, "color": {"b": 255, "g": 230, "r": 160}, "content": {"bold": false, "isOutlineEnabled": true, "isShadowEnabled": true, "italic": false, "outlineColor": "18;8;40", "outlineThickness": 3, "shadowAngle": 90, "shadowBlurRadius": 4, "shadowColor": "0;0;0", "shadowDistance": 4, "shadowOpacity": 140, "smoothed": true, "underlined": false, "text": "BannerText", "font": "Righteous-Regular.ttf", "textAlignment": "center", "verticalTextAlignment": "top", "characterSize": 34, "lineHeight": 0, "color": "160;230;255"}}, {"assetStoreId": "", "bold": false, "italic": false, "name": "FloatText", "smoothed": true, "type": "TextObject::Text", "underlined": false, "variables": [], "effects": [], "behaviors": [], "string": "FloatText", "font": "Righteous-Regular.ttf", "textAlignment": "center", "characterSize": 34, "color": {"b": 120, "g": 220, "r": 255}, "content": {"bold": false, "isOutlineEnabled": true, "isShadowEnabled": true, "italic": false, "outlineColor": "18;8;40", "outlineThickness": 3, "shadowAngle": 90, "shadowBlurRadius": 4, "shadowColor": "0;0;0", "shadowDistance": 4, "shadowOpacity": 140, "smoothed": true, "underlined": false, "text": "FloatText", "font": "Righteous-Regular.ttf", "textAlignment": "center", "verticalTextAlignment": "top", "characterSize": 34, "lineHeight": 0, "color": "255;220;120"}}], "objectsFolderStructure": {"folderName": "__ROOT", "children": [{"objectName": "Background"}, {"objectName": "Guide"}, {"objectName": "Wisp"}, {"objectName": "WispFace"}, {"objectName": "Shield"}, {"objectName": "Shard"}, {"objectName": "Mote"}, {"objectName": "Vignette"}, {"objectName": "Flash"}, {"objectName": "LifeRing"}, {"objectName": "BurstDark"}, {"objectName": "BurstLost"}, {"objectName": "BurstGold"}, {"objectName": "BurstHit"}, {"objectName": "BurstDeath"}, {"objectName": "Embers"}, {"objectName": "TitleText"}, {"objectName": "SubText"}, {"objectName": "HintText"}, {"objectName": "TapText"}, {"objectName": "ScoreText"}, {"objectName": "BestText"}, {"objectName": "ComboText"}, {"objectName": "BannerText"}, {"objectName": "FloatText"}]}, "events": [{"type": "BuiltinCommonInstructions::Comment", "color": {"b": 109, "g": 230, "r": 255, "textB": 0, "textG": 0, "textR": 0}, "comment": "WISP WARDEN - GDevelop BIG Game Jam #10, theme \"Keep It Alive\".\nTurn the shield (mouse/touch/arrow keys) to block dark shards and let gold motes reach the wisp. The wisp's light fades over time; gold refills it."}, {"colorB": 160, "colorG": 90, "colorR": 70, "creationTime": 0, "name": "Setup", "source": "", "type": "BuiltinCommonInstructions::Group", "events": [{"type": "BuiltinCommonInstructions::Standard", "conditions": [{"type": {"value": "DepartScene"}, "parameters": [""]}], "actions": [{"type": {"value": "SceneBackground"}, "parameters": ["", "8;6;22"]}, {"type": {"value": "ChangePlan"}, "parameters": ["Shard", "=", "20"]}], "events": [{"type": "BuiltinCommonInstructions::JsCode", "inlineCode": ["// Wisp Warden - scene setup. All tunable values live here.", "const G = {", "  CX: 640, CY: 380, R: 150, SPAWN_R: 780, WISP_R: 40,", "  state: \"title\", t: 0, life: 100, score: 0, best: 0, combo: 0, bestCombo: 0,", "  shieldA: -90, target: -90, shieldW: 120, spawnT: 1.2, ents: [], fx: [],", "  shake: 0, flash: 0, flashColor: \"255;255;255\", hurt: 0, pulse: 0, heartT: 0,", "  prevDown: false, prevMX: -1, prevMY: -1, stateT: 0, newBest: false,", "  banner: \"\", bannerT: 0, milestone: 0, blocked: 0, saved: 0, shieldKick: 0,", "};", "try { G.best = parseInt(localStorage.getItem(\"wispwarden_best\") || \"0\", 10) || 0; } catch (e) {}", "runtimeScene.__G = G;", "const flash = runtimeScene.getObjects(\"Flash\")[0];", "flash.setWidth(1280); flash.setHeight(720); flash.setOpacity(0);", "", "// Exposed for automated playtesting.", "if (typeof window !== \"undefined\") window.__wwScene = runtimeScene;", ""], "parameterObjects": "", "useStrict": true, "eventsSheetExpanded": true}]}], "parameters": []}, {"colorB": 70, "colorG": 90, "colorR": 160, "creationTime": 0, "name": "Game loop", "source": "", "type": "BuiltinCommonInstructions::Group", "events": [{"type": "BuiltinCommonInstructions::Comment", "color": {"b": 109, "g": 230, "r": 255, "textB": 0, "textG": 0, "textR": 0}, "comment": "Input, spawn director, collisions, juice (particles, screen shake, flashes, sounds) and UI."}, {"type": "BuiltinCommonInstructions::JsCode", "inlineCode": ["// Wisp Warden - main loop: input, spawning director, collisions, juice and UI.", "const G = runtimeScene.__G;", "if (!G) return;", "const dt = Math.min(0.05, gdjs.evtTools.runtimeScene.getElapsedTimeInSeconds(runtimeScene));", "const im = runtimeScene.getGame().getInputManager();", "const uiLayer = runtimeScene.getLayer(\"UI\");", "const baseLayer = runtimeScene.getLayer(\"\");", "const one = (n) => runtimeScene.getObjects(n)[0];", "const wisp = one(\"Wisp\"), face = one(\"WispFace\"), shield = one(\"Shield\"), ring = one(\"LifeRing\");", "const embers = one(\"Embers\"), flash = one(\"Flash\"), vig = one(\"Vignette\"), guide = one(\"Guide\");", "const T = { title: one(\"TitleText\"), sub: one(\"SubText\"), hint: one(\"HintText\"), tap: one(\"TapText\"),", "  score: one(\"ScoreText\"), best: one(\"BestText\"), combo: one(\"ComboText\"), banner: one(\"BannerText\") };", "const snd = (f, v, p) => gdjs.evtTools.sound.playSound(runtimeScene, f, false, v, p || 1);", "const wrap = (a) => { a = (a + 180) % 360; if (a < 0) a += 360; return a - 180; };", "const rnd = (a, b) => a + Math.random() * (b - a);", "const center = (o, x, y) => { o.setX(x - o.getWidth() / 2); o.setY(y); };", "const burst = (name, x, y, layer) => { const b = runtimeScene.createObject(name); if (b) { b.setPosition(x, y); if (layer) b.setLayer(layer); } return b; };", "const floatText = (txt, x, y, color, size) => {", "  const o = runtimeScene.createObject(\"FloatText\"); if (!o) return;", "  o.setLayer(\"UI\"); o.setText(txt); o.setColor(color); o.setCharacterSize(size || 34);", "  G.fx.push({ o, x, y, t: 0, life: 0.9 });", "};", "const { CX, CY, R } = G;", "", "// ---------- Input ----------", "const [mx, my] = uiLayer.convertCoords(im.getCursorX(), im.getCursorY());", "const down = im.isMouseButtonPressed(0);", "const keyStart = im.isKeyPressed(32) || im.isKeyPressed(13);", "const tapped = im.isMouseButtonReleased(0) || (keyStart && !G.prevKey);", "G.prevDown = down; G.prevKey = keyStart;", "const moved = Math.abs(mx - G.prevMX) + Math.abs(my - G.prevMY) > 0.5;", "G.prevMX = mx; G.prevMY = my;", "if ((moved || down) && Math.hypot(mx - CX, my - CY) > 12) G.target = Math.atan2(my - CY, mx - CX) * 180 / Math.PI;", "const kl = im.isKeyPressed(37) || im.isKeyPressed(65) || im.isKeyPressed(81);", "const kr = im.isKeyPressed(39) || im.isKeyPressed(68);", "if (kl) G.target = G.shieldA - 40; if (kr) G.target = G.shieldA + 40;", "", "// ---------- State machine ----------", "G.stateT += dt;", "const startRun = () => {", "  for (const e of G.ents) e.o.deleteFromScene(runtimeScene);", "  G.ents = []; G.state = \"play\"; G.t = 0; G.life = 100; G.score = 0; G.combo = 0; G.bestCombo = 0;", "  G.spawnT = 1.0; G.stateT = 0; G.newBest = false; G.milestone = 0; G.blocked = 0; G.saved = 0; G.hits = 0; G.lost = 0;", "  G.flash = 120; G.flashColor = \"255;240;200\";", "  snd(\"start.mp3\", 70);", "  if (!G.musicOn) { gdjs.evtTools.sound.playMusic(runtimeScene, \"music.mp3\", true, 45, 1); G.musicOn = true; }", "  G.banner = \"Keep it alive!\"; G.bannerT = 2.2;", "};", "if (G.state === \"title\" && tapped) startRun();", "else if (G.state === \"over\" && tapped && G.stateT > 0.8) startRun();", "", "const playing = G.state === \"play\";", "if (playing) {", "  G.t += dt;", "  const t = G.t;", "  // difficulty curve: a typical run lasts 1-3 minutes", "  const decay = Math.min(8, 2.4 + t * 0.032);", "  G.life -= decay * dt;", "  G.score += dt * 10;", "  G.shieldW = t < 40 ? 120 : t < 80 ? 105 : t < 120 ? 90 : 78;", "  const anim = { 120: 0, 105: 1, 90: 2, 78: 3 }[G.shieldW];", "  if (shield.getAnimation() !== anim) { shield.setAnimation(anim); G.shieldKick = 0.3; if (t > 1) { G.banner = \"Your shield is shrinking...\"; G.bannerT = 2; } }", "  const milestones = [[20, \"The dark grows restless\"], [35, \"Shards are spiralling!\"], [60, \"They come in pairs now\"], [90, \"Swarm incoming!\"], [120, \"Legendary warden!\"], [160, \"How is it still alive?!\"]];", "  if (G.milestone < milestones.length && t >= milestones[G.milestone][0]) { G.banner = milestones[G.milestone][1]; G.bannerT = 2.4; G.milestone++; }", "", "  // ---------- Spawn director ----------", "  G.spawnT -= dt;", "  if (G.spawnT <= 0) {", "    G.spawnT = Math.max(0.36, 1.2 - t * 0.0085) * rnd(0.8, 1.2);", "    const sv = Math.min(390, 150 + t * 2.1), mv = Math.min(270, 130 + t * 1.1);", "    // add(kind, angle, arrival time in seconds until it reaches the shield ring)", "    const add = (kind, a, arrive, extra) => {", "      const o = runtimeScene.createObject(kind === \"shard\" ? \"Shard\" : \"Mote\");", "      const e = Object.assign({ o, kind, a, v: kind === \"shard\" ? sv : mv, w: 0, pr: 9999 }, extra || {});", "      e.r = R + e.v * arrive;", "      o.setPosition(CX + Math.cos(e.a * Math.PI / 180) * e.r, CY + Math.sin(e.a * Math.PI / 180) * e.r);", "      G.ents.push(e);", "    };", "    const A = (G.SPAWN_R - R) / mv; // slowest speed sets the shared arrival time, so everything spawns off-screen", "    const a = rnd(-180, 180), roll = Math.random();", "    const moteChance = G.life < 35 ? 0.45 : t < 20 ? 0.4 : 0.32;", "    if (roll < moteChance) add(\"mote\", a, A);", "    else if (t > 60 && roll < moteChance + 0.18) { add(\"mote\", a, A); add(\"shard\", a + rnd(-8, 8), A + 0.6); } // trojan: gold first, dark right behind", "    else if (t > 35 && roll < moteChance + 0.34) add(\"shard\", a, A, { w: (Math.random() < 0.5 ? -1 : 1) * rnd(20, 45) }); // spiral", "    else if (t > 90 && roll < moteChance + 0.46) { for (let k = -1; k <= 1; k++) add(\"shard\", a + k * 34, A); } // swarm fan", "    else if (t > 15 && roll < moteChance + 0.58) { add(\"shard\", a, A); add(\"shard\", a + 180 + rnd(-30, 30), A + Math.max(0.55, 0.85 - t * 0.002)); } // pincer", "    else add(\"shard\", a, (G.SPAWN_R - R) / sv);", "    if (G.spawnT < 0.9 && roll >= moteChance) G.spawnT += 0.25; // breathing room after combos", "  }", "", "  // ---------- Shield ----------", "  const diff = wrap(G.target - G.shieldA);", "  const step = 760 * dt;", "  G.shieldA += Math.max(-step, Math.min(step, diff));", "  G.shieldA = wrap(G.shieldA);", "}", "", "// ---------- Entities ----------", "const wispR = G.WISP_R * (0.75 + 0.45 * Math.max(0, G.life) / 100);", "for (let i = G.ents.length - 1; i >= 0; i--) {", "  const e = G.ents[i];", "  if (playing) { e.pr = e.r; e.r -= e.v * dt; e.a += e.w * dt; }", "  const rad = e.a * Math.PI / 180;", "  const x = CX + Math.cos(rad) * e.r, y = CY + Math.sin(rad) * e.r;", "  e.o.setPosition(x, y);", "  if (e.kind === \"shard\") e.o.setAngle(e.a + 180 + e.w * 0.5); else { const s = 0.9 + 0.15 * Math.sin(G.t * 10 + i); e.o.setScale(s); }", "  if (!playing) continue;", "  let remove = false;", "  const halfW = G.shieldW / 2 + (e.kind === \"shard\" ? 7 : 4);", "  if (e.pr > R + 8 && e.r <= R + 8 && Math.abs(wrap(e.a - G.shieldA)) <= halfW) {", "    remove = true;", "    if (e.kind === \"shard\") {", "      burst(\"BurstDark\", x, y); snd(\"block.mp3\", 55, rnd(0.9, 1.25));", "      G.score += 5; G.blocked++; G.shieldKick = 0.18; G.shake = Math.max(G.shake, 4);", "    } else {", "      burst(\"BurstLost\", x, y); snd(\"lost.mp3\", 60, 1); G.lost = (G.lost || 0) + 1;", "      if (G.combo >= 3) floatText(\"combo lost\", x, y - 20, \"190;190;220\", 26);", "      G.combo = 0;", "    }", "  } else if (e.r <= wispR + 6) {", "    remove = true;", "    if (e.kind === \"shard\") {", "      G.life -= 22; G.hits = (G.hits || 0) + 1; G.combo = 0; G.hurt = 0.6; G.shake = 22; G.flash = 150; G.flashColor = \"255;40;90\";", "      burst(\"BurstHit\", CX, CY); snd(\"hit.mp3\", 90, rnd(0.9, 1.05));", "      floatText(\"-22\", CX + rnd(-30, 30), CY - 80, \"255;90;140\", 40);", "    } else {", "      G.combo++; G.bestCombo = Math.max(G.bestCombo, G.combo); G.saved++;", "      const gain = 10 * G.combo;", "      G.life = Math.min(100, G.life + 15); G.score += gain; G.pulse = 0.35;", "      burst(\"BurstGold\", CX, CY); snd(\"collect.mp3\", 60, Math.min(2, 1 + (G.combo - 1) * 0.06));", "      floatText(\"+\" + gain + (G.combo > 1 ? \"  x\" + G.combo : \"\"), CX + rnd(-40, 40), CY - 90, \"255;220;120\", G.combo > 4 ? 44 : 36);", "    }", "  }", "  if (remove) { e.o.deleteFromScene(runtimeScene); G.ents.splice(i, 1); }", "}", "", "// ---------- Death ----------", "if (playing && G.life <= 0) {", "  G.life = 0; G.state = \"over\"; G.stateT = 0;", "  burst(\"BurstDeath\", CX, CY); snd(\"gameover.mp3\", 80); G.shake = 30; G.flash = 200; G.flashColor = \"255;255;255\";", "  const s = Math.floor(G.score);", "  if (s > G.best) { G.best = s; G.newBest = true; try { localStorage.setIt